<% content_for :title, "Usuários" %>

<h1>Usuários</h1>

<ul class="lista-usuarios" role="list">
  <% @users.each do |user| %>
    <li>
      <strong><%= user.nome %></strong> (<%= user.login %>)<br>
      <span><%= user.email %></span><br>
      <span><%= t("user.roles.#{user.role}") %></span>
      <%= link_to "Alterar nível", edit_admin_user_path(user) %>
    </li>
  <% end %>
</ul>
