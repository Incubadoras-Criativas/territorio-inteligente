<% content_for :title, "Meu perfil" %>

<h1>Meu perfil</h1>

<%= form_with model: @user, url: perfil_path, method: :patch do |f| %>
  <%= f.aviso_erros %>

  <div class="field">
    <%= f.label :nome %>
    <%= f.text_field :nome, autocomplete: "name" %>
  </div>

  <div class="field">
    <%= f.label :login %>
    <%= f.text_field :login, autocomplete: "username" %>
  </div>

  <fieldset class="campo">
    <legend>Escolha seu avatar</legend>
    <%= f.erro_de(:avatar) %>

    <div class="opcoes-avatar">
      <label class="opcao-avatar">
        <%= f.radio_button :avatar, "", class: "visualmente-oculto" %>
        <%= icone("user") %>
        <span class="visualmente-oculto">Sem avatar</span>
      </label>

      <% User.avatares_disponiveis.sort.each_with_index do |arquivo, i| %>
        <label class="opcao-avatar">
          <%= f.radio_button :avatar, arquivo, class: "visualmente-oculto" %>
          <%= image_tag "avatares/#{arquivo}", alt: "Avatar #{i + 1}", loading: "lazy", width: 64, height: 64 %>
        </label>
      <% end %>
    </div>
  </fieldset>

  <%= f.erros_restantes %>

  <%= f.submit "Salvar" %>
<% end %>

<p><%= link_to "Trocar e-mail ou senha", edit_user_registration_path %></p>
