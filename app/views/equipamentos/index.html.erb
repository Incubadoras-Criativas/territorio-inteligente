<% content_for :title, "Guia dos equipamentos" %>

<h1>Guia dos equipamentos</h1>

<ul class="lista-equipamentos" role="list">
  <% @equipamentos.each do |equipamento| %>
    <li>
      <%= link_to equipamento_path(equipamento), class: "cartao-equipamento" do %>
        <% if equipamento.capa.attached? %>
          <%= image_tag equipamento.capa.variant(:miniatura), alt: "" %>
        <% else %>
          <span class="sem-imagem" aria-hidden="true">?</span>
        <% end %>
        <span><%= equipamento.nome %></span>
        <% unless equipamento.visivel %>
          <span class="etiqueta-rascunho">Rascunho</span>
        <% end %>
      <% end %>
    </li>
  <% end %>
</ul>
