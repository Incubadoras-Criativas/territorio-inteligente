<% unless @equipamento.visivel %>
  <p class="aviso-rascunho">Rascunho: este equipamento ainda não está visível para o público.</p>
<% end %>

<% content_for :title, @equipamento.nome %>

<article class="guia-equipamento">
  <h1><%= @equipamento.nome %></h1>

  <% if @equipamento.capa.attached? %>
    <%= image_tag @equipamento.capa.variant(:media), alt: "Foto do equipamento #{@equipamento.nome}", class: "capa" %>
  <% end %>

  <% if (conteudo = @equipamento.conteudo) %>
    <%= conteudo.html_safe %>
  <% else %>
    <p>Este guia ainda está em construção.</p>
  <% end %>

  <% if @equipamento.fotos.attached? %>
    <h2>Fotos</h2>
    <ul class="galeria" role="list">
      <% @equipamento.fotos.each_with_index do |foto, i| %>
        <li><%= image_tag foto.variant(:media), alt: "Foto #{i + 1} do equipamento #{@equipamento.nome}", loading: "lazy" %></li>
      <% end %>
    </ul>
  <% end %>
</article>

<p><%= link_to "Todos os equipamentos", equipamentos_path %></p>
