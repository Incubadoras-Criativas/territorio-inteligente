<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) || "Território Inteligente" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Território Inteligente">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="topo">
      <%= link_to "Território Inteligente", root_path, class: "marca" %>
    </header>

    <main data-controller="validacao"
      data-action="focusout->validacao#sair input->validacao#digitar change->validacao#escolher submit->validacao#enviar">
      <p class="notice" role="status"><%= notice %></p>
      <p class="alert" role="alert"><%= alert %></p>

      <%= yield %>
    </main>

    <nav class="barra-abas" aria-label="Navegação principal">
      <%= link_to academias_path, class: "aba", aria: { current: ("page" if controller_name == "academias") } do %>
        <%= icone("map-pin") %><span>Academias</span>
      <% end %>

      <%= link_to equipamentos_path, class: "aba", aria: { current: ("page" if controller_name == "equipamentos") } do %>
        <%= icone("dumbbell") %><span>Equipamentos</span>
      <% end %>

      <% if user_signed_in? %>
        <%= link_to edit_perfil_path, class: "aba", aria: { current: ("page" if controller_name == "perfis") } do %>
          <% if current_user.avatar_exibivel %>
            <%= image_tag "avatares/#{current_user.avatar}", alt: "", class: "icone" %>
          <% else %>
            <%= icone("user") %>
          <% end %>
          <span>Perfil</span>
        <% end %>
      <% else %>
        <%= link_to new_user_session_path, class: "aba" do %>
          <%= icone("log-in") %><span>Entrar</span>
        <% end %>
      <% end %>
      <div class="aba">
        <button type="button" class="aba" popovertarget="menu-completo">
          <%= icone("menu") %><span>Menu</span>
         </button>
      </div>
    </nav>

    <div id="menu-completo" class="menu-completo" popover>
      <button type="button" class="fechar-menu" popovertarget="menu-completo" popovertargetaction="hide">
        <%= icone("x") %><span>Fechar</span>
      </button>

      <nav aria-label="Menu completo">
        <h2 class="menu-secao">Navegar</h2>
        <ul role="list">
          <li><%= link_to "Início", root_path %></li>
          <li><%= link_to "Academias", academias_path %></li>
          <li><%= link_to "Equipamentos", equipamentos_path %></li>
        </ul>

        <h2 class="menu-secao">Sua conta</h2>
        <ul role="list">
          <% if user_signed_in? %>
            <li><%= link_to "Meu perfil", edit_perfil_path %></li>
            <li><%= link_to "Minha galeria", imagens_path %></li>
            <li><%= link_to "Trocar e-mail ou senha", edit_user_registration_path %></li>
          <% else %>
            <li><%= link_to "Entrar", new_user_session_path %></li>
            <li><%= link_to "Cadastrar", new_user_registration_path %></li>
          <% end %>
        </ul>

        <% if user_signed_in? && current_user.admin? %>
          <h2 class="menu-secao">Administração</h2>
          <ul role="list">
            <li><%= link_to "Usuários", admin_users_path %></li>
            <li><%= link_to "Gerenciar equipamentos", admin_equipamentos_path %></li>
          </ul>
        <% end %>

        <h2 class="menu-secao">Sobre</h2>
        <ul role="list" class="menu-sobre">
          <li><%= link_to "Política de privacidade", privacidade_path %></li>
          <li><%= link_to "Código-fonte (AGPL-3.0)", "https://github.com/Incubadoras-Criativas/territorio-inteligente" %></li>
        </ul>

        <% if user_signed_in? %>
          <%= button_to "Sair", destroy_user_session_path, method: :delete %>
        <% end %>
      </nav>
    </div>


  </body>
</html>
